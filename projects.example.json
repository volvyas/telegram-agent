{
  "modelProviders": {
    "openai-default": {
      "type": "codex-builtin",
      "provider": "openai"
    },
    "ollama-local": {
      "type": "codex-builtin",
      "provider": "ollama"
    },
    "lmstudio-local": {
      "type": "codex-builtin",
      "provider": "lmstudio"
    },
    "home-llama": {
      "type": "responses",
      "name": "Home llama.cpp",
      "baseUrl": "http://192.168.1.179:8080/v1",
      "wireApi": "responses"
    }
  },
  "projects": {
    "motor": {
      "name": "Motor Backend",
      "path": "/home/user/projects/motor-backend",
      "agent": {
        "provider": "home-llama",
        "model": "Qwen3.8-Flash-Next-UD-IQ1_S-00001-of-00003.gguf",
        "context": {
          "windowTokens": 32768,
          "outputReserveTokens": 4096,
          "safetyMarginTokens": 2048
        }
      },
      "codexHome": "/home/service-user/.local/share/codex-remote/motor-codex-home",
      "testCommand": {
        "executable": "./mvnw",
        "args": ["test"]
      },
      "buildCommand": {
        "executable": "./mvnw",
        "args": ["package", "-DskipTests"]
      },
      "issueTracker": {
        "type": "github",
        "owner": "example-org",
        "repository": "motor-backend",
        "tokenEnv": "GITHUB_MOTOR_ISSUES_TOKEN",
        "apiVersion": "2026-03-10",
        "pageSize": 10
      },
      "branch": "main",
      "allowedOperations": ["task", "status", "git", "diff", "test", "build", "stop", "commit"]
    },
    "detective": {
      "name": "Detective Bot",
      "path": "/home/user/projects/detective-bot",
      "testCommand": {
        "executable": "npm",
        "args": ["test"]
      },
      "allowedOperations": ["task", "status", "git", "diff", "test", "stop"]
    },
    "legacy": {
      "name": "Legacy Service",
      "path": "/home/user/projects/legacy-service",
      "allowedOperations": ["task", "status", "stop"],
      "issueTracker": {
        "type": "jira"
      }
    }
  }
}
