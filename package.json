{
  "name": "codex-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Local Telegram gateway for controlling Codex coding agents",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "probe:provider": "tsx scripts/probe-provider.ts",
    "log:provider": "tsx scripts/log-provider.ts",
    "accept:dev071": "tsx scripts/dev071-live.mts"
    ,"generate:web-password-hash": "tsx scripts/generate-web-password-hash.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@grammyjs/runner": "2.0.3",
    "@openai/codex-sdk": "^0.154.0",
    "grammy": "1.45.1"
  }
}
