TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
PROJECTS_CONFIG=./projects.json
LOG_LEVEL=info

# Recommended: an absolute path outside all configured repositories.
CODEX_HOME=/home/user/.local/share/codex-remote/codex-home

# Set each project tracker token in the variable named by its tokenEnv setting.
GITHUB_MOTOR_ISSUES_TOKEN=

# Optional model-provider credentials. Values are never stored in projects.json;
# use the exact variable name referenced by a provider's apiKeyEnv.
# HOME_LLAMA_API_KEY=
# OLLAMA_MODEL_API_KEY=
# LMSTUDIO_MODEL_API_KEY=
