TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
WEB_ENABLED=false
# Web-only deployments set TELEGRAM_ENABLED=false and omit Telegram values.
# Development HTTP (loopback or explicitly firewalled private LAN):
# WEB_ENVIRONMENT=development
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# WEB_PUBLIC_URL=http://127.0.0.1:8080
# WEB_TLS_MODE=direct
# WEB_PASSWORD_HASH=
# Production direct TLS additionally requires:
# WEB_ENVIRONMENT=production
# WEB_PUBLIC_URL=https://agent.example.test
# WEB_TLS_CERT_PATH=/etc/codex-remote/tls/cert.pem
# WEB_TLS_KEY_PATH=/etc/codex-remote/tls/key.pem
PROJECTS_CONFIG=./projects.json
LOG_LEVEL=info

# Recommended: an absolute path outside all configured repositories.
CODEX_HOME=/home/user/.local/share/codex-remote/codex-home

# Set each project tracker token in the variable named by its tokenEnv setting.
GITHUB_MOTOR_ISSUES_TOKEN=

# Optional model-provider credentials. Values are never stored in projects.json;
# use the exact variable name referenced by a provider's apiKeyEnv.
# HOME_LLAMA_API_KEY=
# OLLAMA_MODEL_API_KEY=
# LMSTUDIO_MODEL_API_KEY=
